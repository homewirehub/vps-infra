# Copy to .env on the server and fill in. .env is gitignored on purpose:
# it is the only file that names this specific host.

# Hostname Traefik should request a certificate for. Must already resolve
# to this server's public IPv4, or the ACME challenge fails.
SITE_HOST=example.com

# Address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=you@example.com

# Timezone for container logs.
TZ=UTC

# Basic-auth credential for the Traefik dashboard. Generate with:
#   htpasswd -nbB admin '<password>'
# In a compose .env a literal $ must be doubled, so replace every $ with $$.
DASHBOARD_AUTH=admin:$$2y$$05$$replace.this.with.a.real.bcrypt.hash
